package templates

import "fmt"

// TagBadge renders a non-interactive tag. The color comes from the stylesheet
// keyed on data-tag, so the vocabulary in tags.go stays the only list to edit.
templ TagBadge(tag string) {
	<span class="tag" data-tag={ tag }>{ tag }</span>
}

// TagLink renders a tag that filters the index. active draws the selected state,
// and query carries the current search so the two filters compose.
templ TagLink(tag string, active bool, query string) {
	<a class={ "tag", templ.KV("tag-active", active) } data-tag={ tag } href={ templ.SafeURL(ArticleFilterURL(tag, query)) }>
		{ tag }
	</a>
}

// ArticleSearchForm is a plain GET form: the server ranks and renders results,
// so search works with JavaScript disabled and leaves no query in any log.
templ ArticleSearchForm(view ArticleIndexView) {
	<form class="flex flex-wrap justify-center items-center gap-2 mb-6" method="get" action="/articles/" role="search">
		if view.ActiveTag != "" {
			<input type="hidden" name="tag" value={ view.ActiveTag }/>
		}
		<label class="sr-only" for="article-search">Search articles</label>
		<input
			class="input input-bordered w-full max-w-md"
			id="article-search"
			type="search"
			name="q"
			value={ view.Query }
			placeholder="Search articles…"
			autocomplete="off"
			maxlength="128"
		/>
		<button class="btn btn-primary rounded-xl font-semibold" type="submit">Search</button>
		if view.Searching() {
			<a class="btn btn-ghost border border-base-300 rounded-xl" href={ templ.SafeURL(ArticleFilterURL(view.ActiveTag, "")) }>Clear</a>
		}
	</form>
}

// ArticleCard renders one article teaser. priority marks the card that is above
// the fold on its page: its cover is the Largest Contentful Paint candidate, so
// it must load eagerly — lazy-loading it would delay the metric it defines.
templ ArticleCard(article Article, priority bool) {
	<article class="card bg-base-100 border border-base-300 shadow-lg hover:shadow-xl transition-shadow overflow-hidden h-full">
		<a href={ templ.SafeURL("/articles/" + article.Slug + "/") } class="block">
			if priority {
				<img class="w-full aspect-[16/9] object-cover" src={ templ.SafeURL(article.CardImagePath()) } alt={ article.ImageAlt } width={ fmt.Sprintf("%d", CardCoverWidth) } height="450" fetchpriority="high" decoding="async"/>
			} else {
				<img class="w-full aspect-[16/9] object-cover" src={ templ.SafeURL(article.CardImagePath()) } alt={ article.ImageAlt } width={ fmt.Sprintf("%d", CardCoverWidth) } height="450" loading="lazy" decoding="async"/>
			}
		</a>
		<div class="card-body p-5 sm:p-6">
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-base-content/65">
				<time datetime={ article.Date.Format("2006-01-02") }>{ article.Date.Format("Jan 2, 2006") }</time>
				<span aria-hidden="true">·</span>
				<span>{ fmt.Sprintf("%d min read", article.ReadingMinutes) }</span>
			</div>
			// h3: cards always sit under a section heading (year, "Articles",
			// "Keep reading"), so the page outline stays sequential.
			<h3 class="card-title font-heading text-xl leading-snug mt-2">
				<a class="hover:text-primary transition-colors" href={ templ.SafeURL("/articles/" + article.Slug + "/") }>{ article.Title }</a>
			</h3>
			<p class="text-base-content/75 leading-relaxed mt-2">{ article.Description }</p>
			if len(article.Tags) > 0 {
				<ul class="flex flex-wrap gap-2 mt-4" aria-label="Article tags">
					for _, tag := range article.Tags {
						<li>
							@TagBadge(tag)
						</li>
					}
				</ul>
			}
		</div>
	</article>
}

templ ArticleIndex(view ArticleIndexView) {
	<section class="bg-base-200 min-h-screen px-4 py-14 md:py-20">
		<div class="container mx-auto max-w-6xl">
			<header class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
				<p class="text-sm uppercase tracking-[0.2em] text-primary font-semibold mb-3">Writing</p>
				<h1 class="text-4xl md:text-6xl font-heading font-black text-balance">Articles</h1>
				<p class="text-lg text-base-content/70 leading-relaxed mt-5">Pragmatic field notes on AI agents, MLOps, cloud architecture, and engineering systems.</p>
			</header>
			@ArticleSearchForm(view)
			<nav class="flex flex-wrap justify-center gap-2 mb-12" aria-label="Filter articles by tag">
				<a class={ "tag", templ.KV("tag-active", view.ActiveTag == "") } href={ templ.SafeURL(ArticleFilterURL("", view.Query)) }>All</a>
				for _, tag := range view.Tags {
					@TagLink(tag, view.ActiveTag == tag, view.Query)
				}
			</nav>
			if view.Searching() {
				<section aria-labelledby="search-results">
					<h2 id="search-results" class="text-2xl font-heading font-bold mb-6 border-b border-base-300 pb-3">
						{ fmt.Sprintf("%d result%s for", len(view.Results), plural(len(view.Results))) }
						<span class="text-primary">“{ view.Query }”</span>
					</h2>
					if len(view.Results) == 0 {
						<div class="alert max-w-2xl mx-auto"><span>No articles match this search. Try a broader term, or browse the tags above.</span></div>
					}
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						for rank, article := range view.Results {
							@ArticleCard(article, rank == 0)
						}
					</div>
				</section>
			} else {
				if len(view.Years) == 0 {
					<div class="alert max-w-2xl mx-auto"><span>No articles match this tag.</span></div>
				}
				<div class="space-y-16">
					for groupIndex, group := range view.Years {
						<section aria-labelledby={ fmt.Sprintf("year-%d", group.Year) }>
							<h2 id={ fmt.Sprintf("year-%d", group.Year) } class="text-3xl font-heading font-bold mb-6 border-b border-base-300 pb-3">{ fmt.Sprintf("%d", group.Year) }</h2>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								for articleIndex, article := range group.Articles {
									@ArticleCard(article, groupIndex == 0 && articleIndex == 0)
								}
							</div>
						</section>
					}
				</div>
			}
		</div>
	</section>
}

// ArticleFooter closes the loop on an article page. Most readers arrive here
// straight from a search engine or a syndicated copy, so the page has to say who
// wrote it and offer a next step instead of ending at the last paragraph.
templ ArticleFooter(related []Article) {
	<footer class="max-w-4xl mx-auto mt-16 md:mt-20 space-y-12">
		<section class="card bg-base-200 border border-base-300" aria-labelledby="article-author">
			<div class="card-body p-6 md:p-8 flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
				<img
					class="w-20 h-20 rounded-full object-cover ring ring-primary ring-offset-base-100 ring-offset-2 shrink-0"
					src={ StaticURL("static/img/avatar-192.webp") }
					alt={ METADATA.Name }
					width="80"
					height="80"
					loading="lazy"
					decoding="async"
				/>
				<div class="flex-1 min-w-0">
					<h2 id="article-author" class="font-heading text-xl font-bold">
						<a class="hover:text-primary transition-colors" href="/#about">{ METADATA.Name } ({ METADATA.AlternateName })</a>
					</h2>
					<p class="text-sm text-primary font-semibold mt-1">{ METADATA.JobTitle }</p>
					<p class="text-base-content/75 leading-relaxed mt-3">{ METADATA.Description }</p>
				</div>
				<div class="flex flex-col gap-2 w-full sm:w-auto shrink-0">
					<a
						class="btn btn-primary rounded-xl font-bold"
						href={ templ.SafeURL(METADATA.CalendarURL) }
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a Session
					</a>
					<a class="btn btn-ghost border border-base-300 rounded-xl" href={ templ.SafeURL("mailto:" + METADATA.Email) }>
						Contact Me
					</a>
				</div>
			</div>
		</section>
		if len(related) > 0 {
			<section aria-labelledby="related-articles">
				<h2 id="related-articles" class="font-heading text-2xl font-bold mb-6 flex items-center gap-2">
					<span class="w-2 h-8 bg-primary rounded-full" aria-hidden="true"></span>
					Keep reading
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					for _, item := range related {
						@ArticleCard(item, false)
					}
				</div>
			</section>
		}
		<div class="flex flex-wrap justify-center items-center gap-3 text-sm">
			<a class="btn btn-outline btn-primary rounded-full font-semibold" href="/articles/">All articles</a>
			<a class="btn btn-ghost border border-base-300 rounded-full" href="/articles/feed.xml">Subscribe (Atom)</a>
		</div>
	</footer>
}

templ ArticlePage(article Article, related []Article) {
	// article-page is the container body figures measure themselves against when
	// they break out of the text column; the rule lives in input.css because the
	// renderer, not a template, emits those figures.
	<article class="article-page bg-base-100 min-h-screen px-4 py-12 md:py-20">
		<header class="max-w-4xl mx-auto text-center mb-10 md:mb-14">
			<a class="link link-primary font-semibold" href="/articles/">← All articles</a>
			<h1 class="font-heading text-4xl md:text-6xl font-black leading-tight text-balance mt-6">{ article.Title }</h1>
			<p class="text-xl text-base-content/70 leading-relaxed mt-6 text-balance">{ article.Description }</p>
			<div class="flex flex-wrap justify-center items-center gap-x-3 gap-y-2 text-sm text-base-content/65 mt-6">
				<time datetime={ article.Date.Format("2006-01-02") }>{ article.Date.Format("January 2, 2006") }</time>
				<span aria-hidden="true">·</span>
				<span>{ fmt.Sprintf("%d min read", article.ReadingMinutes) }</span>
			</div>
			if len(article.Tags) > 0 {
				<ul class="flex flex-wrap justify-center gap-2 mt-6" aria-label="Article tags">
					for _, tag := range article.Tags {
						<li>
							@TagLink(tag, false, "")
						</li>
					}
				</ul>
			}
		</header>
		// Code blocks stay on the brand panel palette in both themes:
		// slate-800/700/50 are the exact brand panel, border, and foreground.
		<div class="prose prose-lg md:prose-xl mx-auto max-w-4xl text-base-content prose-headings:font-heading prose-headings:scroll-mt-24 prose-a:text-primary prose-img:rounded-xl prose-img:shadow-lg prose-pre:bg-slate-800 prose-pre:text-slate-50 prose-pre:border prose-pre:border-slate-700 prose-code:before:content-none prose-code:after:content-none [&_video]:my-10 [&_video]:w-full [&_video]:rounded-xl [&_video]:shadow-lg">
			@templ.Raw(article.HTML)
		</div>
		for _, page := range SITE_PAGES {
			if page.RelatesTo(article.Slug) {
				<aside class="max-w-4xl mx-auto rounded-2xl border border-primary/30 bg-primary/5 p-6 my-10">
					<p class="text-sm font-semibold uppercase tracking-wider">Put the ideas into practice</p>
					<a class="link link-primary font-heading text-xl font-bold block mt-2" href={ templ.SafeURL("/sites/" + page.Slug + "/") }>{ page.Title } →</a>
					<p class="text-base-content/75 mt-3">Try the decision tool to compare demand, API bills, hosting capacity, and cost per accepted task.</p>
				</aside>
			}
		}
		@ArticleFooter(related)
	</article>
}
