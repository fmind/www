package templates

import "fmt"

templ SiteIndex(pages []SitePage) {
	<section class="bg-base-200 min-h-screen px-4 py-14 md:py-20">
		<div class="container mx-auto max-w-6xl">
			<header class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
				<p class="text-sm uppercase tracking-[0.2em] text-primary font-semibold mb-3">Explore and decide</p>
				<h1 class="text-4xl md:text-6xl font-heading font-black text-balance">Sites</h1>
				<p class="text-lg text-base-content/70 leading-relaxed mt-5">Focused, source-backed tools for decisions that deserve more than a spreadsheet guess.</p>
			</header>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				for _, page := range pages {
					<article class="card bg-base-100 border border-base-300 shadow-lg h-full">
						<div class="card-body p-6 md:p-8">
							<p class="text-sm uppercase tracking-[0.16em] text-primary font-semibold">For { page.Audience }</p>
							<h2 class="card-title font-heading text-2xl mt-2">
								<a class="hover:text-primary transition-colors" href={ templ.SafeURL("/sites/" + page.Slug + "/") }>{ page.Title }</a>
							</h2>
							<p class="text-base-content/75 leading-relaxed mt-3">{ page.Description }</p>
							<div class="card-actions mt-5">
								<a class="btn btn-primary rounded-xl font-bold" href={ templ.SafeURL("/sites/" + page.Slug + "/") }>Open calculator</a>
							</div>
						</div>
					</article>
				}
			</div>
		</div>
	</section>
}

templ MetricCard(label, value, detail string) {
	<div class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm">
		<p class="text-sm font-semibold text-base-content/65">{ label }</p>
		<output class="block font-heading text-3xl font-black text-primary mt-2">{ value }</output>
		<p class="text-sm text-base-content/65 leading-relaxed mt-2">{ detail }</p>
	</div>
}

templ LLMSelfHosting(view LLMSelfHostingView) {
	<section data-hosting-calculator class="bg-base-200 min-h-screen px-4 py-10 md:py-16">
		<p data-update-status class="sr-only" role="status"></p>
		<div class="container mx-auto max-w-7xl space-y-10 md:space-y-14">
			<nav aria-label="Breadcrumb" class="text-sm text-base-content/70">
				<a class="link hover:text-primary" href="/sites/">Sites</a>
				<span aria-hidden="true">/ </span><span aria-current="page">LLM self-hosting</span>
			</nav>
			<header class="max-w-5xl">
				<p class="text-sm uppercase tracking-[0.18em] text-primary font-semibold mb-4">The economics of AI · GKE Standard</p>
				<h1 class="text-4xl md:text-6xl font-heading font-black text-balance">When does self-hosting an LLM pay off?</h1>
				<p class="text-lg md:text-xl text-base-content/80 leading-relaxed mt-5 max-w-4xl">Compare GKE fleet costs, API pricing, and capacity for your workload.</p>
				<p class="text-sm text-base-content/70 mt-4">USD planning estimates · Source snapshot { view.SnapshotDate } · No GPU benchmark is implied.</p>
				<nav aria-label="On this page" class="flex flex-wrap gap-x-6 gap-y-3 mt-6 text-sm font-semibold">
					<a class="link link-primary" href="#calculator">Try a scenario</a>
					<a class="link link-primary" href="#executive-result">Compare costs</a>
					<a class="link link-primary" href="#cost-explorer">Explore the figures</a>
					<a class="link link-primary" href="#precision-guide">Understand 4, 8, and 16-bit</a>
					<a class="link link-primary" href="#quality-lab">Evaluate value</a>
				</nav>
			</header>
			if len(view.Validation) > 0 {
				<div class="alert alert-warning" role="alert">
					<div>
						<p class="font-bold">Some inputs need attention.</p>
						<ul class="list-disc ml-5 mt-1">
							for _, message := range view.Validation {
								<li>{ message }</li>
							}
						</ul>
					</div>
				</div>
			}
			<form id="calculator" method="get" action="/sites/llm-self-hosting/" class="space-y-6 scroll-mt-24" aria-label="GKE self-hosting scenario">
				// Enter updates the edited fields instead of activating the first preset.
				<button type="submit" hidden tabindex="-1" aria-hidden="true">Update comparison</button>
				@HostingDemandForm(view)
				<div id="hosting-options" class="space-y-6">
					@HostingFleetForm(view)
					@HostingAPIOptions(view)
				</div>
				<div class="flex flex-wrap items-center gap-4">
					<button id="update-comparison" class="btn btn-primary rounded-xl font-bold min-h-12" type="submit">Update comparison</button>
					<a class="btn btn-ghost border border-base-300 rounded-xl min-h-12" id="reset-scenario" data-scenario-link href="/sites/llm-self-hosting/">Reset assumptions</a>
					<p class="text-sm text-base-content/70">Share the URL to save this scenario.</p>
				</div>
			</form>
			@HostingResults(view)
			@HostingCostExplorer(view)
			@HostingSensitivity(view)
			@HostingLatency(view)
			@HostingPrecisionGuide(view)
			<section aria-labelledby="frontier-table" class="space-y-5">
				<div class="max-w-4xl">
					<p class="text-sm uppercase tracking-[0.18em] text-primary font-semibold">Frontier comparison</p>
					<h2 id="frontier-table" class="text-3xl md:text-4xl font-heading font-black mt-2">Top 10 open-weight models</h2>
					<p class="text-base-content/75 leading-relaxed mt-3">Artificial Analysis Intelligence Index v{ view.IndexVersion }, ranked by evaluated variant. Costs reuse your fleet settings; speed and quantized quality require measurement.</p>
				</div>
				<div class="overflow-x-auto rounded-2xl border border-base-300 bg-base-100 shadow-sm focus-visible:outline-2 focus-visible:outline-primary" role="region" aria-label="Open-weight model comparison, scroll horizontally on small screens" tabindex="0">
					<table class="table table-zebra w-full">
						<caption class="sr-only">Top ten open-weight models and modeled GKE footprint and cost</caption>
						<thead><tr><th scope="col">Rank and model</th><th scope="col">AA index</th><th scope="col">License</th><th scope="col">Memory</th><th scope="col">Fleet</th><th scope="col">Monthly</th><th scope="col">Decision</th></tr></thead>
						<tbody>
							for _, row := range view.Comparison {
								<tr>
									<th scope="row"><a class="link link-primary font-semibold" href={ templ.SafeURL(row.Model.AnalysisURL) } target="_blank" rel="noopener noreferrer">#{ fmt.Sprintf("%d", row.Model.Rank) } · { row.Model.Name }</a><span class="block text-xs font-normal text-base-content/60 mt-1">{ row.Model.Creator } · { fmt.Sprintf("%.0fB", row.Model.ParametersB) } parameters</span></th>
									<td>{ fmt.Sprintf("%.1f", row.Model.Intelligence) }</td>
									<td><a class="link" href={ templ.SafeURL(row.Model.WeightsURL) } target="_blank" rel="noopener noreferrer">{ row.Model.License }</a><span class="block text-xs text-base-content/60">{ row.Model.LicenseClass }</span></td>
									<td>{ fmt.Sprintf("%.0f GB", row.Estimate.RequiredMemoryGB) }</td>
									<td>{ FormatCount(row.Estimate.TotalNodes, "node") + " / " + FormatCount(row.Estimate.TotalGPUs, "GPU") }</td>
									<td>{ FormatUSD(row.Estimate.TotalMonthlyUSD) }</td>
									<td>{ row.Decision }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
			@HostingQuality(view)
			@HostingRelatedArticles(view.RelatedArticles)
			<details id="hosting-method" class="rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8">
				<summary class="cursor-pointer font-heading text-xl font-bold">Method and limitations</summary>
				<ul class="list-disc ml-5 mt-4 space-y-2 text-sm text-base-content/75">
					<li>Whole GPU nodes, total model weights, and an editable runtime-memory reserve.</li>
					<li>Fleet cost includes compute, the GKE cluster fee, and your operations budget. Commitments remain billed while idle.</li>
					<li>Capacity uses output throughput × replicas × usable share × running hours. Validate peak traffic separately.</li>
					<li>API bills include input, output, and the selected batch or cache mode. Tools, media, taxes, regional premiums, and negotiated rates are excluded.</li>
					<li>Validate quality, KV-cache memory, multi-node efficiency, regional availability, and model terms in a pilot.</li>
				</ul>
			</details>
			<details id="hosting-sources" class="rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8">
				<summary class="cursor-pointer font-heading text-xl font-bold">Sources and freshness · { view.SnapshotDate }</summary>
				<p class="text-base-content/70 mt-2">Snapshot checked { view.SnapshotDate }. Prices and rankings move; follow the linked authority before committing spend.</p>
				<ul class="mt-5 space-y-3">
					<li><a class="link link-primary font-semibold" href={ templ.SafeURL(view.ModelSourceURL) } target="_blank" rel="noopener noreferrer">Artificial Analysis model leaderboard</a><span class="block text-sm text-base-content/65">Independent Intelligence Index v{ view.IndexVersion }, open-weight status, model parameters, context, and license links.</span></li>
					<li><a class="link link-primary font-semibold" href={ templ.SafeURL(view.GKESourceURL) } target="_blank" rel="noopener noreferrer">Google Kubernetes Engine pricing</a><span class="block text-sm text-base-content/65">$0.10 per cluster-hour management fee and GKE billing boundaries.</span></li>
					<li><a class="link link-primary font-semibold" href={ templ.SafeURL(view.PriceSourceURL) } target="_blank" rel="noopener noreferrer">Google Cloud accelerator-optimized VM pricing</a><span class="block text-sm text-base-content/65">A4, A3, and A2 machine composition and list-price options used here.</span></li>
					<li><a class="link link-primary font-semibold" href="https://cloud.google.com/compute/docs/accelerator-optimized-machines" target="_blank" rel="noopener noreferrer">Google Cloud accelerator-optimized machine specifications</a><span class="block text-sm text-base-content/65">GPU count, GPU memory, host memory, networking, and provisioning constraints.</span></li>
					<li><a class="link link-primary font-semibold" href="https://docs.cloud.google.com/compute/docs/instances/signing-up-committed-use-discounts" target="_blank" rel="noopener noreferrer">Google Cloud committed-use billing</a><span class="block text-sm text-base-content/75">Committed resources are billed throughout the term, including unused hours.</span></li>
					for _, baseline := range view.APIs {
						<li><a class="link link-primary font-semibold" href={ templ.SafeURL(baseline.Baseline.SourceURL) } target="_blank" rel="noopener noreferrer">{ baseline.Baseline.Name } pricing</a><span class="block text-sm text-base-content/75">{ baseline.Baseline.Note }</span><span class="block text-sm text-base-content/75 mt-1">{ baseline.Freshness }</span><a class="link link-primary text-sm" href={ templ.SafeURL(baseline.Baseline.CacheURL) } target="_blank" rel="noopener noreferrer">Cache fees and requirements</a></li>
					}
					<li><a class="link link-primary font-semibold" href="https://docs.vllm.ai/en/latest/features/quantization/" target="_blank" rel="noopener noreferrer">vLLM quantization documentation</a><span class="block text-sm text-base-content/75">Memory trade-offs and format support by GPU and runtime implementation.</span></li>
				</ul>
			</details>
		</div>
	</section>
}

// Keep the legend inside a padded panel: native fieldset legends interrupt its border.
templ HostingDemandForm(view LLMSelfHostingView) {
	<div class="rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8 shadow-sm">
		<fieldset class="min-w-0">
			<legend class="font-heading text-2xl font-bold">1 · Start with the work you need done</legend>
			<p class="text-base-content/75 mt-3">Presets change demand and keep your fleet settings.</p>
			<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 mt-5">
				for _, preset := range view.Presets {
					<button type="submit" id={ "preset-" + preset.ID } name="preset" value={ preset.ID } aria-pressed={ fmt.Sprintf("%t", view.DemandLabel == preset.Name) } class="min-w-0 rounded-xl border border-base-300 p-4 text-left hover:border-primary hover:bg-primary/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary aria-pressed:border-primary aria-pressed:bg-primary/5 transition-colors">
						<span class="block font-bold text-primary">{ preset.Name }</span>
						<span class="block text-sm text-base-content/75 leading-relaxed mt-2">{ preset.Description }</span>
					</button>
				}
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mt-6">
				@HostingNumberInput("requests", "Requests per active day", view.Inputs.RequestsPerDay, "1", "10000000", "any", "Include every model call in agent and tool loops.")
				@HostingNumberInput("days", "Active days per month", view.Inputs.ActiveDays, "1", "31", "1", "1 for a one-off job; 22 for workdays; 30 for daily traffic.")
				@HostingNumberInput("input-tokens", "Input tokens per request", view.Inputs.InputTokensRequest, "1", "1000000", "1", "Include instructions, retrieved context, history, and tool results.")
				@HostingNumberInput("tokens", "Output tokens per request", view.Inputs.OutputTokensRequest, "1", "1000000", "1", "Include billed reasoning tokens; use observed usage.")
			</div>
		</fieldset>
	</div>
}

templ HostingNumberInput(id, label string, value float64, minimum, maximum, step, help string) {
	<div class="min-w-0">
		<label class="block font-semibold text-sm mb-2" for={ id }>{ label }</label>
		<input class="input input-bordered w-full min-w-0" id={ id } name={ id } form="calculator" type="number" min={ minimum } max={ maximum } step={ step } value={ fmt.Sprintf("%g", value) } aria-describedby={ id + "-help" }/>
		<p id={ id + "-help" } class="text-sm text-base-content/70 leading-relaxed mt-2">{ help }</p>
	</div>
}

templ HostingFleetForm(view LLMSelfHostingView) {
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
		<div class="min-w-0 rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8 shadow-sm">
			<fieldset class="min-w-0 space-y-5">
				<legend class="font-heading text-2xl font-bold mb-5">2 · Choose a model and precision</legend>
				<div>
					<label class="block font-semibold text-sm mb-2" for="model">Open-weight model</label>
					<select class="select select-bordered w-full min-w-0" id="model" name="model" aria-describedby="model-help">
						for _, model := range view.Models {
							<option value={ model.ID } selected?={ model.ID == view.Inputs.ModelID }>#{ fmt.Sprintf("%d", model.Rank) } · { model.Name }</option>
						}
					</select>
					<p id="model-help" class="text-sm text-base-content/70 leading-relaxed mt-2">Choose the smallest model that meets your quality bar.</p>
				</div>
				<div>
					<label class="block font-semibold text-sm mb-2" for="quant">Weight precision</label>
					<select class="select select-bordered w-full min-w-0" id="quant" name="quant" aria-describedby="quant-help">
						for _, quant := range view.Quantizations {
							<option value={ quant.ID } selected?={ quant.ID == view.Inputs.QuantizationID }>{ quant.Name }</option>
						}
					</select>
					<p id="quant-help" class="text-sm text-base-content/70 leading-relaxed mt-2">Start with 8-bit; test 4-bit for memory savings or 16-bit as a precision reference. <a class="link link-primary" href="#precision-guide">See the trade-offs for this model.</a></p>
				</div>
				@HostingNumberInput("overhead", "Runtime memory reserve (%)", view.Inputs.MemoryOverheadPct, "0", "50", "1", "Reserve above weight memory; long context and concurrency need extra KV cache.")
			</fieldset>
		</div>
		<div class="min-w-0 rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8 shadow-sm">
			<fieldset class="min-w-0 space-y-5">
				<legend class="font-heading text-2xl font-bold mb-5">3 · Price the capacity you keep</legend>
				<div>
					<label class="block font-semibold text-sm mb-2" for="node">GPU node and billing plan</label>
					<select class="select select-bordered w-full min-w-0" id="node" name="node" aria-describedby="node-help">
						for _, node := range view.NodePools {
							<option value={ node.ID } selected?={ node.ID == view.Inputs.NodePoolID }>{ node.Name } · { FormatUSD2(node.HourlyUSD) }/h</option>
						}
					</select>
					<p id="node-help" class="text-sm text-base-content/70 leading-relaxed mt-2">Whole-machine pricing. On-demand keeps a pilot flexible.</p>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
					@HostingNumberInput("replicas", "Serving replicas", float64(view.Inputs.Replicas), "1", "8", "1", "Complete model copies; validate failover capacity separately.")
					@HostingNumberInput("duty", "Fleet running time (%)", view.Inputs.DutyCyclePercent, "0.1", "100", "0.1", "100% = 730 h/month. Stopping on-demand nodes saves compute; commitments stay billed.")
				</div>
				@HostingNumberInput("platform", "Additional hosting operations ($/month)", view.Inputs.PlatformMonthlyUSD, "0", "10000000", "1", "Hosting labor, software, and support beyond costs common to both options.")
			</fieldset>
		</div>
	</div>
	<div class="rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8">
		<h2 class="font-heading text-xl font-bold">Capacity assumptions</h2>
		<p class="text-sm text-base-content/75 leading-relaxed mt-3">100 tokens/s is illustrative. Re-measure after changing the model, GPU, precision, or workload.</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-5">
			@HostingNumberInput("throughput", "Assumed output tokens/s per replica", view.Inputs.TokensPerSecond, "0.1", "1000000", "any", "Aggregate output across concurrent requests, measured end to end.")
			@HostingNumberInput("utilization", "Usable share of measured throughput (%)", view.Inputs.TargetUtilization, "1", "95", "1", "Planning margin for bursts and overhead; actual demand is separate.")
		</div>
	</div>
}

templ HostingResults(view LLMSelfHostingView) {
	<section aria-labelledby="executive-result" class="space-y-6">
		<div>
			<p class="text-sm uppercase tracking-[0.18em] text-primary font-semibold">Your scenario · { view.DemandLabel }</p>
			<h2 id="executive-result" class="text-3xl md:text-4xl font-heading font-black mt-2 scroll-mt-24">What your demand actually costs</h2>
			<a class="link link-primary text-sm inline-block mt-3" href="#calculator">Change assumptions ↑</a>
			<p class="text-base-content/75 mt-3">{ FormatDecimal(view.Estimate.RequestsMonth, 0) } requests/month · { FormatNumber(view.Estimate.InputTokensMonth) } input tokens · { FormatNumber(view.Estimate.OutputTokensMonth) } output tokens.</p>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			@MetricCard("Self-hosting / month", FormatUSD2(view.Estimate.TotalMonthlyUSD), fmt.Sprintf("%s compute + %s operations + %s GKE fee, including idle time.", FormatUSD2(view.Estimate.ComputeMonthlyUSD), FormatUSD(view.Estimate.PlatformMonthlyUSD), FormatUSD(view.Estimate.ControlMonthlyUSD)))
			@MetricCard("Fleet footprint", FormatCount(view.Estimate.TotalNodes, "node")+" · "+FormatCount(view.Estimate.TotalGPUs, "GPU"), fmt.Sprintf("%s · %.1f GB memory floor per replica · %s per replica.", view.SelectedModel.Name, view.Estimate.RequiredMemoryGB, FormatCount(view.Estimate.NodesPerReplica, "node")))
			@MetricCard("Share of modeled capacity needed", fmt.Sprintf("%.1f%%", view.Estimate.DemandCapacityPct), fmt.Sprintf("Demand / usable output capacity of %s tokens/month. Over 100%% means this fleet is too small.", FormatNumber(view.Estimate.CapacityTokensMonth)))
		</div>
		<div class="rounded-2xl border border-primary/30 bg-primary/5 p-6" role="status">
			<p class="font-heading text-xl font-bold">{ hostingDecisionTitle(view) }</p>
			<p class="text-base-content/80 leading-relaxed mt-2">{ hostingDecisionCopy(view) }</p>
			<p class="text-sm text-base-content/75 mt-3">{ view.SelectedNode.Name }: { view.SelectedNode.Operational }</p>
		</div>
		<div>
			<h3 class="font-heading text-2xl font-bold">Three managed API baselines</h3>
			<p class="text-base-content/75 leading-relaxed mt-2">Same request count and token mix, using your selected API mode. Compare quality separately.</p>
		</div>
		@HostingAPICards(view)
		<div class="hidden md:block overflow-x-auto rounded-2xl border border-base-300 bg-base-100 shadow-sm focus-visible:outline-2 focus-visible:outline-primary" role="region" aria-label="API cost comparison" tabindex="0">
			<table class="table w-full">
				<caption class="sr-only">Monthly costs and break-even at the selected input and output token mix</caption>
				<thead><tr><th scope="col">Option</th><th scope="col">Standard input / output<br/>USD per 1M tokens</th><th scope="col">Your monthly bill</th><th scope="col">Per 1,000 requests</th><th scope="col">Self-hosting break-even</th></tr></thead>
				<tbody>
					<tr class="bg-primary/5">
						<th scope="row">Your GKE fleet<span class="block font-normal text-xs mt-1">{ view.SelectedNode.Name }</span></th>
						<td>Fixed fleet cost</td>
						<td class="font-bold whitespace-nowrap">{ FormatUSD2(view.Estimate.TotalMonthlyUSD) }</td>
						<td>
							if view.Estimate.DemandFits {
								{ FormatUSD2(view.Estimate.PerThousandRequestsUSD) }
							} else {
								<span>Insufficient capacity</span>
							}
						</td>
						<td>Reference fleet<span class="block text-xs mt-1">{ fmt.Sprintf("%.1f%%", view.Estimate.DemandCapacityPct) } of usable capacity needed</span></td>
					</tr>
					for _, row := range view.APIs {
						<tr>
							<th scope="row"><a class="link link-primary" href={ templ.SafeURL(row.Baseline.SourceURL) } target="_blank" rel="noopener noreferrer">{ row.Baseline.Name }</a></th>
							<td class="whitespace-nowrap">{ FormatUSD2(row.Baseline.InputPerMillion) } / { FormatUSD2(row.Baseline.OutputPerMillion) }</td>
							<td class="font-bold whitespace-nowrap">{ FormatUSD2(row.MonthlyUSD) }</td>
							<td>{ FormatUSD2(row.PerThousandRequestsUSD) }</td>
							<td>
								{ FormatNumber(row.BreakEvenRequests) } requests/month
								if row.BreakEvenFits {
									<span class="block text-xs mt-1">Within modeled capacity; quality still unproved</span>
								} else {
									<span class="block text-xs font-semibold mt-1">Beyond this fleet's modeled capacity</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<details id="hosting-price-notes" class="rounded-xl border border-base-300 bg-base-100 p-5">
			<summary class="cursor-pointer font-semibold focus-visible:outline-2 focus-visible:outline-primary">Price notes and comparison boundaries · { view.SnapshotDate }</summary>
			<ul class="list-disc ml-5 space-y-3 mt-4 text-sm text-base-content/75">
				for _, row := range view.APIs {
					<li><strong>{ row.Baseline.Name }:</strong> { row.Baseline.Note }<p class="mt-2">{ row.ModeNote }</p><p class="mt-2">{ row.Freshness }</p></li>
				}
				<li>API estimates include input and output tokens. The selected mode includes either batch discounts or eligible cache reads, writes, and storage. Tools, media, taxes, regional premiums, and negotiated rates are excluded. API quotas and context limits still apply.</li>
				<li>Include billed reasoning in output tokens and all repeated tool calls in demand. These inputs cannot predict each model's actual verbosity, retries, or task success.</li>
				<li>For a one-off job, the API bill covers just that job. The fleet bill still covers your selected monthly running time. Reduce running time only if you can actually stop on-demand nodes, allowing for startup and processing.</li>
			</ul>
		</details>
	</section>
}

templ HostingPrecisionGuide(view LLMSelfHostingView) {
	<section aria-labelledby="precision-guide" class="space-y-5">
		<h2 id="precision-guide" class="font-heading text-3xl md:text-4xl font-black scroll-mt-24">4, 8, or 16-bit: what are you trading?</h2>
		<p class="text-base-content/75 leading-relaxed max-w-4xl">Memory and fleet cost for <strong>{ view.SelectedModel.Name }</strong>, with the same fleet settings.</p>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
			for _, row := range view.Precisions {
				<article class="rounded-2xl border border-base-300 bg-base-100 p-6">
					<h3 class="font-heading text-xl font-bold">{ row.Quantization.Name }</h3>
					<p class="font-heading text-3xl font-bold text-primary mt-4">{ fmt.Sprintf("%.1f GB", row.Estimate.WeightMemoryGB) }<span class="block font-body text-sm font-normal text-base-content/70 mt-1">weights only, per replica</span></p>
					<p class="font-semibold mt-4">{ FormatCount(row.Estimate.TotalNodes, "node") } · { FormatUSD2(row.Estimate.TotalMonthlyUSD) }/month</p>
					<p class="text-sm text-base-content/75 leading-relaxed mt-3">{ row.Quantization.Guidance }</p>
				</article>
			}
		</div>
		<p class="text-sm text-base-content/75">Compression cuts the bill only when it reduces whole-node requirements or improves measured throughput. Check KV-cache memory and <a class="link link-primary" href="https://docs.vllm.ai/en/latest/features/quantization/" target="_blank" rel="noopener noreferrer">runtime and GPU format support</a>.</p>
	</section>
}

func hostingDecisionTitle(view LLMSelfHostingView) string {
	if !view.Estimate.DemandFits {
		return "This fleet cannot cover the modeled demand"
	}
	if cheapestHostingAPI(view).MonthlyUSD < view.Estimate.TotalMonthlyUSD {
		return "Start with an API on cost grounds"
	}
	return "Self-hosting has a cost case to test"
}

func hostingDecisionCopy(view LLMSelfHostingView) string {
	if !view.Estimate.DemandFits {
		return "Do not treat the current fleet bill as a quote for all this work. Increase replicas, measure a faster configuration, or reduce demand, then recalculate. A monthly average cannot establish peak-time capacity."
	}
	if cheapestHostingAPI(view).MonthlyUSD < view.Estimate.TotalMonthlyUSD {
		return fmt.Sprintf("%s is %s/month for this token mix, versus %s for your fleet. Self-hosting needs enough value from control, residency, customization, or avoided quality failures to cover the difference. Compare task success before choosing.", cheapestHostingAPI(view).Baseline.Name, FormatUSD2(cheapestHostingAPI(view).MonthlyUSD), FormatUSD2(view.Estimate.TotalMonthlyUSD))
	}
	return "The modeled fleet bill is below these API baselines at your demand. This is a candidate for a pilot: verify quality, sustained throughput, memory, model terms, and an operating owner before committing capacity."
}

func cheapestHostingAPI(view LLMSelfHostingView) APIComparison {
	cheapest := view.APIs[0]
	for _, row := range view.APIs[1:] {
		if row.MonthlyUSD < cheapest.MonthlyUSD {
			cheapest = row
		}
	}
	return cheapest
}
