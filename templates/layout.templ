package templates

import (
	"fmt"
	"time"
)

// NAV_LINKS holds only same-page section anchors, so every entry behaves
// identically when clicked. Full-page destinations (Articles, Sites) are
// rendered apart from this list (see DestinationNavLinks) instead of being mixed in,
// where they would look like sections that scroll but silently leave the page.
var NAV_LINKS = []map[string]string{
	{"href": "/#about", "label": "About"},
	{"href": "/#work-experience", "label": "Work Experience"},
	{"href": "/#certifications", "label": "Certifications"},
	{"href": "/#projects", "label": "Projects"},
	{"href": "/#services", "label": "Services"},
}

// DestinationNavLinks keeps full pages visually distinct from the homepage's
// section anchors while giving both desktop destinations the same behavior.
templ DestinationNavLinks() {
	<a class="btn btn-sm btn-outline btn-primary rounded-xl font-semibold gap-1.5 px-4" href="/articles/">
		@Icon("article", "h-4 w-4")
		Articles
	</a>
	<a class="btn btn-sm btn-outline btn-primary rounded-xl font-semibold gap-1.5 px-4" href="/sites/">
		<span class="text-base leading-none select-none" aria-hidden="true">🌐</span>
		Sites
	</a>
}

templ NavigationBar() {
	<nav class="navbar bg-base-100/90 backdrop-blur-md border-b border-base-200" aria-label="Primary navigation">
		<div class="container mx-auto flex px-4">
			// Start section (Mobile menu toggle + brand)
			<div class="flex-1 flex items-center gap-1 sm:gap-4">
				// Mobile menu: toggled by the vanilla script at the end of <body>.
				<div class="2xl:hidden relative">
					<button id="menu-toggle" class="btn btn-ghost btn-circle btn-sm md:btn-md" aria-label="Menu" aria-controls="mobile-menu" aria-expanded="false">
						@Icon("menu", "h-5 w-5")
					</button>
					<ul id="mobile-menu" class="menu menu-sm absolute left-0 mt-3 z-[50] p-2 shadow bg-base-100 rounded-box w-52 border border-base-200 hidden">
						for _, link := range NAV_LINKS {
							<li>
								<a class="font-medium hover:text-primary py-2" href={ templ.SafeURL(link["href"]) }>{ link["label"] }</a>
							</li>
						}
						<li class="mt-1 pt-1 border-t border-base-200">
							<a class="font-semibold text-primary py-2" href="/articles/">
								@Icon("article", "h-4 w-4")
								Articles
							</a>
						</li>
						<li>
							<a class="font-semibold text-primary py-2" href="/sites/">
								<span class="text-base leading-none select-none" aria-hidden="true">🌐</span>
								Sites
							</a>
						</li>
					</ul>
				</div>
				<a class="btn btn-ghost text-xl md:text-2xl font-bold font-heading text-primary normal-case gap-2 sm:gap-4 px-1 sm:px-2" href="/">
					<img class="w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full object-cover" src={ StaticURL("static/img/logo.webp") } alt={ METADATA.SiteName + " logo" } width="48" height="48" decoding="async"/>
					<span class="hidden sm:inline">{ METADATA.SiteName }</span>
				</a>
				<ul class="menu menu-horizontal px-1 hidden 2xl:flex gap-1">
					for _, link := range NAV_LINKS {
						<li>
							<a class="relative font-medium hover:text-primary transition-colors duration-150 after:content-[''] after:absolute after:w-full after:scale-x-0 after:h-0.5 after:bottom-0 after:left-0 after:bg-primary after:origin-bottom-right after:transition-transform after:duration-300 hover:after:scale-x-100 hover:after:origin-bottom-left py-2 px-3" href={ templ.SafeURL(link["href"]) }>
								{ link["label"] }
							</a>
						</li>
					}
				</ul>
				<div class="hidden xl:flex items-center gap-3">
					<div class="border-l border-base-content/20 h-6" aria-hidden="true"></div>
					@DestinationNavLinks()
				</div>
			</div>
			// End section (Social icons + theme toggle)
			<div class="flex-none flex items-center gap-1 md:gap-4">
				<div class="flex gap-0 md:gap-2">
					for _, social := range METADATA.Socials {
						if social.Header {
							<a class="btn btn-ghost btn-circle btn-sm md:btn-md hover:bg-transparent hover:text-accent transition-colors" href={ templ.SafeURL(social.URL) } target="_blank" rel="noopener noreferrer" aria-label={ social.Name }>
								@Icon(social.Icon, "h-4 w-4 sm:h-5 sm:w-5 md:h-6 md:w-6")
							</a>
						}
					}
				</div>
				<div class="border-l border-base-content/20 h-6 md:h-8 mx-0.5 md:mx-2"></div>
				// Theme toggle: which icon shows is driven purely by CSS keyed on the
				// <html data-theme> the head script sets before first paint (no FOUC).
				<button id="theme-toggle" class="btn btn-ghost btn-circle btn-sm md:btn-md bg-base-200/60 border border-base-content/10" aria-label="Switch to dark theme" aria-pressed="false">
					<span class="theme-icon-moon">
						@Icon("moon", "h-5 w-5 md:h-6 md:w-6")
					</span>
					<span class="theme-icon-sun">
						@Icon("sun", "h-5 w-5 md:h-6 md:w-6")
					</span>
				</button>
			</div>
		</div>
	</nav>
}

templ PageFooter() {
	<footer class="footer footer-center px-4 py-8 sm:p-8 bg-slate-950 text-slate-400 border-t border-slate-900">
		<aside class="min-w-0 w-full space-y-2">
			<p class="font-heading font-semibold text-lg md:text-xl italic text-slate-100">
				Everyday excellence builds tomorrow's success.
			</p>
			<div class="flex flex-wrap items-center justify-center gap-2 text-xs sm:text-sm">
				<nav class="flex shrink-0 gap-0 sm:gap-1" aria-label="Social profiles">
					for _, social := range METADATA.Socials {
						if social.Header {
							<a class="btn btn-ghost btn-circle btn-xs sm:btn-sm text-slate-300 hover:text-white" href={ templ.SafeURL(social.URL) } target="_blank" rel="noopener noreferrer" aria-label={ social.Name }>
								@Icon(social.Icon, "h-4 w-4 sm:h-5 sm:w-5")
							</a>
						}
					}
				</nav>
				<div class="hidden sm:block border-l border-slate-700 h-5 shrink-0" aria-hidden="true"></div>
				<span>
					<a class="link hover:text-white" href="/llms.txt">For AI agents</a>
					<span aria-hidden="true">· </span>
					<a class="link hover:text-white" href="/sites/">Sites</a>
					<span aria-hidden="true">· </span>
					<a class="link hover:text-white" href="/api/profile">JSON profile</a>
					<span aria-hidden="true">· </span>
					// The server card, not /mcp itself: /mcp is the JSON-RPC endpoint and
					// answers GET with 405, so a browser clicking through would hit an error.
					<a class="link hover:text-white" href="/mcp/server-card">MCP</a>
				</span>
			</div>
			<p class="text-sm">
				© { fmt.Sprintf("%d", time.Now().Year()) } { METADATA.Name } ({ METADATA.AlternateName }). All rights reserved.
			</p>
		</aside>
	</footer>
}

templ Layout(body templ.Component, page PageMetadata) {
	<!DOCTYPE html>
	<html lang="en" class={ templ.KV("scroll-smooth", !page.InstantScroll) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ page.Title }</title>
			if !page.NoIndex {
				<link rel="canonical" href={ page.Canonical }/>
				<link rel="alternate" type="application/json" href="/api/profile" title="Machine-readable portfolio"/>
				<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-ready portfolio summary"/>
				<link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full LLM-ready portfolio context"/>
				<link rel="alternate" type="application/atom+xml" href="/articles/feed.xml" title="Fmind articles"/>
				<link rel="alternate" type="application/mcp-server-card+json" href="/mcp/server-card" title="Model Context Protocol server card"/>
				if page.Article != nil {
					<link rel="alternate" type="text/markdown" href={ page.Article.MarkdownPath() } title="Article source (Markdown)"/>
				}
			}
			<meta name="theme-color" content="#ffffff"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="author" content={ METADATA.Name + " (" + METADATA.AlternateName + ")" }/>
			<meta name="description" content={ page.Description }/>
			if page.NoIndex {
				<meta name="robots" content="noindex, follow"/>
			} else {
				<meta name="robots" content="index, follow"/>
			}
			for _, s := range METADATA.Socials {
				<link rel="me" href={ s.URL }/>
			}
			<meta property="og:type" content={ page.Kind }/>
			<meta property="og:url" content={ page.Canonical }/>
			<meta property="og:title" content={ page.Title }/>
			<meta property="og:site_name" content={ METADATA.SiteName }/>
			<meta property="og:description" content={ page.Description }/>
			<meta property="og:image" content={ page.ImageURL }/>
			<meta property="og:image:alt" content={ page.ImageAlt }/>
			<meta property="og:locale" content="en_US"/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:site" content={ METADATA.TwitterHandle }/>
			<meta name="twitter:creator" content={ METADATA.TwitterHandle }/>
			<meta name="twitter:title" content={ page.Title }/>
			<meta name="twitter:description" content={ page.Description }/>
			<meta name="twitter:image" content={ page.ImageURL }/>
			<meta name="twitter:image:alt" content={ page.ImageAlt }/>
			<script nonce={ templ.GetNonce(ctx) }>
				(function () {
				  function setTheme(isDark) {
				    var root = document.documentElement;
				    // Only a visible theme swap needs transition suppression. Removing this
				    // class during initial load would restyle the entire document again.
				    if (document.body) {
				      root.classList.add('theme-switching');
				      requestAnimationFrame(function () {
				        requestAnimationFrame(function () { root.classList.remove('theme-switching'); });
				      });
				    }
				    try {
				      localStorage.setItem('theme', isDark ? 'dark' : 'light');
				    } catch (error) {
				      // Storage is optional: privacy settings and full quotas must not break controls.
				      if (error.name !== 'SecurityError' && error.name !== 'QuotaExceededError') throw error;
				    }
				    root.classList.toggle('dark', isDark);
				    root.setAttribute('data-theme', isDark ? 'dark' : 'light');
				    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
				      meta.setAttribute('content', isDark ? '#0f172a' : '#ffffff');
				    });
				  }
				  var savedTheme = null;
				  try {
				    savedTheme = localStorage.getItem('theme');
				  } catch (error) {
				    // Use the system preference when browser policy prevents reading storage.
				    if (error.name !== 'SecurityError') throw error;
				  }
				  var isDark = savedTheme === 'dark' ||
				    (savedTheme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				  setTheme(isDark);
				  window.setTheme = setTheme;
								})();
			</script>
			// Font & image preloads. The font hrefs must match the unversioned @font-face
			// URLs in the stylesheet exactly, otherwise the browser downloads each font twice.
			<link rel="preload" href="/static/fonts/Outfit-Variable.woff2" crossorigin="anonymous" as="font" type="font/woff2"/>
			<link rel="preload" href="/static/fonts/Inter-Variable.woff2" crossorigin="anonymous" as="font" type="font/woff2"/>
			if page.PreloadImage != "" {
				// Unversioned on purpose: it must match the <img src> byte for byte,
				// or the browser downloads the image twice.
				if page.PreloadImageSrcset != "" {
					// A responsive LCP image needs its candidates here too: with href
					// alone the scanner preloads the full-size cover while the layout
					// paints the 800px one, and the phone pays for both.
					<link rel="preload" href={ page.PreloadImage } imagesrcset={ page.PreloadImageSrcset } imagesizes={ page.PreloadImageSizes } fetchpriority="high" as="image"/>
				} else {
					<link rel="preload" href={ page.PreloadImage } fetchpriority="high" as="image"/>
				}
			}
			if page.IsHome {
				<link rel="preload" href={ StaticURL("static/img/avatar-192.webp") } imagesrcset={ fmt.Sprintf("%s 192w, %s 280w, %s 384w", StaticURL("static/img/avatar-192.webp"), StaticURL("static/img/avatar-280.webp"), StaticURL("static/img/avatar.webp")) } imagesizes="(max-width: 639px) 128px, (max-width: 768px) 160px, 192px" fetchpriority="high" as="image"/>
			}
			<link rel="icon" type="image/x-icon" href={ StaticURL("static/favicon.ico") }/>
			<link rel="apple-touch-icon" sizes="180x180" href={ StaticURL("static/img/favicons/apple-touch-icon.png") }/>
			<link rel="icon" type="image/png" sizes="32x32" href={ StaticURL("static/img/favicons/favicon-32x32.png") }/>
			<link rel="icon" type="image/png" sizes="16x16" href={ StaticURL("static/img/favicons/favicon-16x16.png") }/>
			<link rel="manifest" href={ StaticURL("static/site.webmanifest") }/>
			// The validated generated stylesheet is inlined to avoid a render-blocking
			// request. The only scripts are two tiny nonce-authorized inline snippets:
			// the theme initializer above (pre-paint, no FOUC) and the theme/menu and chart handlers
			// at the end of <body>. No framework or external JS is loaded.
			@templ.Raw("<style nonce=\"" + templ.GetNonce(ctx) + "\">" + InlineStyles + "</style>")
			@templ.Raw("<script type=\"application/ld+json\">" + page.StructuredData + "</script>")
		</head>
		// No color transition on <body>: nothing but a theme swap changes its
		// colors, and that swap is meant to be instant.
		<body class="min-h-screen bg-base-100 text-base-content font-body antialiased">
			// Skip to content link for accessibility
			<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-primary text-primary-content px-4 py-2 rounded-md z-[100]">
				Skip to content
			</a>
			// Header / Navbar
			<header class="sticky top-0 z-40">
				@NavigationBar()
			</header>
			// Main content area
			<main class="min-h-screen" id="main-content" tabindex="-1">
				@body
			</main>
			// Footer
			@PageFooter()
			// Theme, menu, and progressive chart interaction use native browser controls,
			// authorized by the CSP nonce, replacing a client-side framework.
			<script nonce={ templ.GetNonce(ctx) }>
				(function () {
				  var toggle = document.getElementById('theme-toggle');
				  if (toggle) {
				    var syncThemeButton = function () {
				      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
				      toggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
				      toggle.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
				    };
				    syncThemeButton();
				    toggle.addEventListener('click', function () {
				      var isDark = document.documentElement.getAttribute('data-theme') !== 'dark';
				      window.setTheme(isDark);
				      syncThemeButton();
				    });
				  }
				  var menuBtn = document.getElementById('menu-toggle');
				  var menu = document.getElementById('mobile-menu');
				  if (menuBtn && menu) {
				    var setOpen = function (open) {
				      menu.classList.toggle('hidden', !open);
				      menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
				    };
				    menuBtn.addEventListener('click', function (e) {
				      e.stopPropagation();
				      setOpen(menu.classList.contains('hidden'));
				    });
				    document.addEventListener('click', function (e) {
				      if (!menu.contains(e.target) && !menuBtn.contains(e.target)) setOpen(false);
				    });
				    document.addEventListener('keydown', function (e) {
				      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
				        setOpen(false);
				        menuBtn.focus();
				      }
				    });
				    menu.querySelectorAll('a').forEach(function (a) {
				      a.addEventListener('click', function () { setOpen(false); });
				    });
				  }
				  // Go supplies all prices and scenario URLs; the slider only selects a frame.
				  function initializeCostCharts(container) {
				  container.querySelectorAll('[data-cost-explorer]').forEach(function (chart) {
				    var range = chart.querySelector('[data-cost-range]');
				    var frames = chart.querySelectorAll('[data-cost-frame]');
				    var cursor = chart.querySelector('[data-cost-cursor]');
				    var output = chart.querySelector('[data-cost-output]');
				    var apply = chart.querySelector('[data-cost-apply]');
				    var selectFrame = function () {
				      var frame = frames[Number(range.value)];
				      cursor.setAttribute('x1', frame.dataset.x);
				      cursor.setAttribute('x2', frame.dataset.x);
				      output.textContent = frame.dataset.summary;
				      apply.setAttribute('href', frame.dataset.url);
				      range.setAttribute('aria-valuetext', frame.dataset.label);
				    };
				    range.addEventListener('input', selectFrame);
				    range.disabled = false;
				    chart.querySelector('[data-cost-controls]').classList.remove('hidden');
				  });
				  }
				  initializeCostCharts(document);

				  // Invalid optional controls must be visible before the browser focuses them.
				  document.addEventListener('invalid', function (event) {
				    var parent = event.target.parentElement;
				    while (parent) {
				      if (parent.tagName === 'DETAILS') parent.open = true;
				      parent = parent.parentElement;
				    }
				  }, true);
				  if (document.querySelector('[data-hosting-calculator]')) {
				    var pendingScenario;
				    async function updateScenario(url, source) {
				      // Only this same-origin, server-rendered calculator supplies replacement markup.
				      if (url.origin !== location.origin || url.pathname !== location.pathname) return;
				      if (pendingScenario) pendingScenario.abort();
				      var request = new AbortController();
				      pendingScenario = request;
				      var current = document.querySelector('[data-hosting-calculator]');
				      current.setAttribute('aria-busy', 'true');
				      try {
				        var response = await fetch(url, { signal: request.signal });
				        if (!response.ok) throw new Error('Calculator response: ' + response.status);
				        var html = await response.text();
				        if (pendingScenario !== request) return;
				        var next = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-hosting-calculator]');
				        if (!next) throw new Error('Calculator markup is missing');
				        // Keep deliberate disclosures and the active control in the same viewport position.
				        current.querySelectorAll('details[id]').forEach(function (details) {
				          var replacement = next.querySelector('#' + details.id);
				          if (replacement) replacement.open = details.open;
				        });
				        var top = source.getBoundingClientRect().top;
				        var sourceID = source.id;
				        current.replaceWith(next);
				        initializeCostCharts(next);
				        var replacement = document.getElementById(sourceID);
				        if (replacement) {
				          replacement.focus({ preventScroll: true });
				          window.scrollBy({ top: replacement.getBoundingClientRect().top - top, behavior: 'instant' });
				        }
				        url.hash = '';
				        history.replaceState(history.state, '', url);
				        next.querySelector('[data-update-status]').textContent = 'Comparison updated.';
				      } catch (error) {
				        if (error.name !== 'AbortError') {
				          var status = current.querySelector('[data-update-status]');
				          status.classList.remove('sr-only');
				          status.setAttribute('role', 'alert');
				          status.textContent = 'Could not update the comparison. Please try again.';
				          source.insertAdjacentElement('afterend', status);
				        }
				      } finally {
				        if (pendingScenario === request) {
				          pendingScenario = null;
				          document.querySelector('[data-hosting-calculator]').removeAttribute('aria-busy');
				        }
				      }
				    }
				    document.addEventListener('submit', function (event) {
				      var form = event.target;
				      if (form.id !== 'calculator') return;
				      event.preventDefault();
				      var url = new URL(form.action);
				      url.search = new URLSearchParams(new FormData(form, event.submitter || undefined));
				      var source = event.submitter && !event.submitter.hidden ? event.submitter : document.activeElement;
				      updateScenario(url, source);
				    });
				    document.addEventListener('click', function (event) {
				      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				      var link = event.target.closest('a[data-scenario-link]');
				      if (!link) return;
				      event.preventDefault();
				      updateScenario(new URL(link.href), link);
				    });
				  }
				})();
			</script>
		</body>
	</html>
}
