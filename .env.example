# Runtime environment: development | production. Default: development.
ENVIRONMENT=development
# HTTP listen port. Default: 8080.
PORT=8080
# Bind IP address for `uv run --locked www`. Default: 127.0.0.1; the container image sets 0.0.0.0 for Cloud Run.
# For `mise run watch`, use GRANIAN_HOST=0.0.0.0 instead to opt in to LAN access.
HOST=127.0.0.1
# Optional: Google Cloud project ID (6-30 chars). Adds Cloud Logging request-trace correlation to operational logs; invalid values fail startup. Unset locally.
# GOOGLE_CLOUD_PROJECT=
