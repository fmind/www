# Runtime environment: development | production. Default: development.
ENVIRONMENT=development
# HTTP listen port. Default: 8080.
PORT=8080
# Optional: set OTEL_EXPORTER_OTLP_ENDPOINT or OTEL_EXPORTER_OTLP_TRACES_ENDPOINT to export traces (e.g. http://localhost:4318).
# Unset both = tracing and trace/span log correlation are disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional: Google Cloud project ID (6-30 chars). Adds Cloud Logging request-trace correlation to operational logs; invalid values fail startup. Unset locally.
# GOOGLE_CLOUD_PROJECT=
